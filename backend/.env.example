# Server
PORT=3001

# Database
DB_PATH=./data/nexusemail.db

# Cloudflare
CLOUDFLARE_API_TOKEN=your_cloudflare_token
CLOUDFLARE_ZONE_ID=your_zone_id

# AWS Route53
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_HOSTED_ZONE_ID=your_hosted_zone_id

# GoDaddy
GODADDY_API_KEY=your_godaddy_key
GODADDY_API_SECRET=your_godaddy_secret

# App Settings
SCAN_SCHEDULE_ENABLED=true
AUTO_REMEDIATION_ENABLED=false
# Production / hosted runtime
NODE_ENV=development
NEXUSEMAIL_DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=change_me

# Auth mode: local for development, whmcs for hosted production
AUTH_MODE=local

# WHMCS hosted integration
WHMCS_API_TOKEN=change_me
WHMCS_WEBHOOK_SECRET=change_me_optional
# Supported aliases:
# NEXUSEMAIL_WHMCS_API_TOKEN=change_me
# NEXUSEMAIL_WHMCS_WEBHOOK_SECRET=change_me_optional
# NEXUSEMAIL_JWT_SECRET=change_me

# Initial platform admin seed / break-glass access
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me
